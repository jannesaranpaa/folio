---
import { useTranslations } from "../i18n/ui";

let t = useTranslations(Astro.currentLocale as "fi" | "en");
---

<div class="p-2 border-b border-line flex gap-2">
	<span class="text-accent font-semibold">{t("header.pageTitle")}</span>
	<div class="flex-1"></div>
	<button
		id="theme-toggle"
		aria-label="Toggle theme"
		class="flex items-center justify-center"
	>
		<span class="icon-[lucide--moon] dark:hidden"></span>
		<span class="icon-[lucide--sun] hidden dark:inline-block"></span>
	</button>
</div>

<script>
	document.getElementById("theme-toggle")?.addEventListener("click", () => {
		const dark = document.documentElement.classList.toggle("dark");
		localStorage.setItem("theme", dark ? "dark" : "light");
	});
</script>
