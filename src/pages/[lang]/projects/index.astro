---
import { getCollection } from "astro:content";

export function getStaticPaths() {
	return [{ params: { lang: "en" } }, { params: { lang: "fi" } }];
}

const { lang } = Astro.params;

// Fetch projects matching the current language directory
const allProjects = await getCollection("projects", ({ id }) => {
	return id.startsWith(`${lang}/`);
});

console.log(allProjects);
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<title>Projects - {lang.toUpperCase()}</title>
	</head>
	<body>
		<h1>Projects ({lang})</h1>
		<ul>
			{allProjects.map((project) => {
				// Removes 'en/' or 'fi/' prefix from the file ID for cleaner URLs
				const slug = project.id.replace(`${lang}/`, "");
				return (
					<li>
						<a href={`/${lang}/projects/${slug}`}>
							{project.data.title}
						</a>
					</li>
				);
			})}
		</ul>
	</body>
</html>
