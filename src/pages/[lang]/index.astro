---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SkillFilter } from "../../components/SkillFilter";
import { useTranslations } from "../../i18n/ui";
import { getCollection } from "astro:content";

export function getStaticPaths() {
	return [{ params: { lang: "en" } }, { params: { lang: "fi" } }];
}

const { lang } = Astro.params as { lang: "en" | "fi" };
const t = useTranslations(lang);
const skills = (await getCollection("skills")).map((s) => ({
	id: s.id,
	...s.data,
}));

// Map filter labels directly from the translation helper
const filterLabels = {
	filterAll: t("skills.filterAll"),
	filterCore: t("skills.filterCore"),
	filterProficient: t("skills.filterProficient"),
	filterFamiliar: t("skills.filterFamiliar"),
};
---

<BaseLayout title={t("home.title")} description={t("home.desc")}>
	<section class="space-y-12">
		<!-- Hero Header -->
		<div class="space-y-4 max-w-2xl">
			<h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">
				{t("hero.title")}
			</h1>
			<p class="text-lg text-slate-400 leading-relaxed">
				{t("hero.subtitle")}
			</p>
		</div>

		<!-- Interactive Skills Section -->
		<div class="space-y-4 pt-4 border-t border-slate-800/80">
			<h2 class="text-xl font-bold tracking-tight">
				{t("skills.heading")}
			</h2>

			<!-- React Island -->
			<SkillFilter client:load skills={skills} labels={filterLabels} />
		</div>
	</section>
</BaseLayout>
